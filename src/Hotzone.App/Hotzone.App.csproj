<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 트레이 아이콘(NotifyIcon)만 WinForms에서 빌려 쓴다 -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- make-icon 개발 명령으로 TrayIcon과 같은 그림에서 만든 파일 -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>HotzoneConverter</AssemblyName>
    <RootNamespace>Hotzone.App</RootNamespace>
    <!-- DPI는 WPF 방식대로 app.manifest(PerMonitorV2)에서 설정. WinForms 경고는 트레이 아이콘만 쓰므로 무시 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- WPF는 System.Windows.Shapes.Path와 충돌을 피하려고 System.IO를 기본 using에서 뺀다 -->
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hotzone.Core\Hotzone.Core.csproj" />
    <ProjectReference Include="..\Hotzone.Converters\Hotzone.Converters.csproj" />
    <ProjectReference Include="..\Hotzone.Interop\Hotzone.Interop.csproj" />
  </ItemGroup>
</Project>
