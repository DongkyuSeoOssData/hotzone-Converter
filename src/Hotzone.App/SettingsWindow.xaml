<Window x:Class="Hotzone.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotzone Converter 환경설정"
        Width="840" Height="680" MinWidth="840" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#FF1C1C20" Foreground="White"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic" FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 왼쪽 메뉴 -->
        <Border Background="#FF161619" BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,22,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,22">
                    <Image x:Name="AppIcon" Width="30" Height="30" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Hotzone" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Converter" FontSize="11" Foreground="#99FFFFFF" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Margin="10,0,0,0" FontSize="11" Foreground="#73FFFFFF" />
                <StackPanel x:Name="Nav" />
            </DockPanel>
        </Border>

        <!-- 오른쪽 페이지 -->
        <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="32,26,32,28">
                <StackPanel x:Name="GeneralPage">
                    <TextBlock Text="열기 방식" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0" Foreground="#B3FFFFFF" TextWrapping="Wrap"
                               Text="탐색기에서 파일을 끌다가 스페이스를 한 번 누르면 변환 패널이 열립니다." />
                    <UniformGrid x:Name="ModeCards" Margin="0,14,0,0" Columns="2" />

                    <TextBlock Text="시작" Margin="0,30,0,0" FontSize="20" FontWeight="SemiBold" />
                    <Border x:Name="StartupRow" Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <Border x:Name="StartupToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleTrack}">
                                <Ellipse x:Name="StartupKnob" Style="{StaticResource ToggleKnob}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Windows 시작 시 자동 실행" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0" Foreground="#B3FFFFFF" Text="로그인하면 트레이에서 바로 대기합니다." />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="LookPage">
                    <TextBlock Text="테마" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0" Foreground="#B3FFFFFF" TextWrapping="Wrap"
                               Text="원형 패널과 알림 창의 모양이에요." />
                    <UniformGrid x:Name="ThemeCards" Margin="0,14,0,0" Columns="2" />
                </StackPanel>

                <StackPanel x:Name="HotzonePage">
                    <StackPanel x:Name="PositionSection">
                        <TextBlock Text="핫존 위치" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="PositionHint" Margin="0,6,0,0" Foreground="#B3FFFFFF" TextWrapping="Wrap" />
                        <Border Style="{StaticResource MapFrame}">
                            <Canvas x:Name="Layout" Width="500" Height="240" ClipToBounds="False" />
                        </Border>
                        <TextBlock x:Name="Selection" Margin="2,14,0,0" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="Warning" Margin="2,4,0,0" Foreground="#FFFFB04A" TextWrapping="Wrap" Visibility="Collapsed"
                                   Text="이 가장자리는 다른 모니터와 맞닿아 있어 커서가 그냥 넘어갈 수 있어요. 바깥쪽 가장자리나 구석을 추천해요." />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="ToastPage">
                    <TextBlock Text="알림" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0" Foreground="#B3FFFFFF" TextWrapping="Wrap"
                               Text="변환 진행률과 열기 버튼을 보여주는 알림 창이에요. 꺼도 작업 기록에는 남아요." />
                    <Border x:Name="ToastRow" Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <Border x:Name="ToastToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleTrack}">
                                <Ellipse x:Name="ToastKnob" Style="{StaticResource ToggleKnob}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="알림 창 보기" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0" Foreground="#B3FFFFFF" Text="변환을 시작하면 화면 구석에 진행 상황을 띄웁니다." />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <StackPanel x:Name="ToastOptions">
                        <TextBlock Text="완료 후 사라지기" Margin="0,24,0,0" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0" Foreground="#B3FFFFFF" Text="모든 작업이 끝난 뒤 알림 창이 닫히기까지의 시간이에요." />
                        <WrapPanel x:Name="DismissOptions" Margin="0,12,0,0" />

                        <TextBlock Text="위치" Margin="0,24,0,0" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0" Foreground="#B3FFFFFF" Text="모니터를 고른 뒤 네 구석 중 하나를 누르세요." />
                        <Border Style="{StaticResource MapFrame}">
                            <Canvas x:Name="ToastLayout" Width="500" Height="180" ClipToBounds="False" />
                        </Border>
                        <TextBlock x:Name="ToastSelection" Margin="2,12,0,0" FontSize="14" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="HistoryPage">
                    <DockPanel>
                        <Border x:Name="ClearHistory" DockPanel.Dock="Right" Style="{StaticResource PillButton}" VerticalAlignment="Center">
                            <TextBlock Text="끝난 기록 지우기" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="작업 기록" FontSize="20" FontWeight="SemiBold" />
                    </DockPanel>
                    <TextBlock Margin="0,6,0,0" Foreground="#B3FFFFFF" TextWrapping="Wrap"
                               Text="진행 중인 작업과 최근 100개의 기록이에요. 결과 파일이나 폴더를 바로 열 수 있어요." />
                    <Border Margin="0,14,0,0" Padding="14,4,14,4" CornerRadius="14" Background="#FF26262B" BorderBrush="#1FFFFFFF" BorderThickness="1">
                        <StackPanel>
                            <StackPanel x:Name="HistoryList" />
                            <TextBlock x:Name="HistoryEmpty" Margin="0,22,0,22" HorizontalAlignment="Center" Foreground="#80FFFFFF"
                                       Text="아직 변환한 파일이 없어요." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
