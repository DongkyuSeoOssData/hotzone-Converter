<Window x:Class="Hotzone.App.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        AllowDrop="True" Background="Transparent"
        FontFamily="Segoe UI Variable Display, Segoe UI, Malgun Gothic">
    <!-- 투명한 부분은 히트 테스트가 안 되므로 원판 밖으로 나가면 DragLeave가 와서 접힌다 -->
    <Canvas x:Name="Root" ClipToBounds="True" />
</Window>
