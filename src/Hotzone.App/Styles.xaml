<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 환경설정의 한 줄 카드 -->
    <Style x:Key="SettingRow" TargetType="Border">
        <Setter Property="Margin" Value="0,14,0,0" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="#FF26262B" />
        <Setter Property="BorderBrush" Value="#1FFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- iOS 스위치: 배경색과 손잡이 위치는 코드에서 켬/끔에 맞춰 바꾼다 -->
    <Style x:Key="ToggleTrack" TargetType="Border">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ToggleKnob" TargetType="Ellipse">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Fill" Value="White" />
    </Style>

    <Style x:Key="MapFrame" TargetType="Border">
        <Setter Property="Margin" Value="0,14,0,0" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="#FF26262B" />
        <Setter Property="BorderBrush" Value="#1FFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="PillButton" TargetType="Border">
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="#FF34343A" />
        <Setter Property="BorderBrush" Value="#26FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="TextElement.Foreground" Value="#FF0A84FF" />
    </Style>

    <!-- 얇은 스크롤 막대 (iOS 느낌): 알림 창과 환경설정 모두에 적용 -->
    <ControlTemplate x:Key="SlimThumb" TargetType="Thumb">
        <Border CornerRadius="3" Background="#8C8E8E96" />
    </ControlTemplate>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="3,2">
                        <Track.Thumb>
                            <Thumb Template="{StaticResource SlimThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2,3">
                                <Track.Thumb>
                                    <Thumb Template="{StaticResource SlimThumb}" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
